# Copy to .env.local and fill in. .env.local is git-ignored; never commit real keys.
# Validated at startup by src/lib/env.schema.ts (see docs/03-Architecture.md section 9).

# --- Supabase -----------------------------------------------------------------
# Local dev: run `npx supabase start`, then `npx supabase status` for these values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS: never import it into client code.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection, used by the LangGraph checkpointer.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# GitHub sign-in (read by the Supabase CLI from config.toml, not by the Next.js app).
# Create an OAuth app with callback URL http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=

# --- LLM and embeddings (needed from M1/M3) ------------------------------------
LLM_PROVIDER=openai            # openai | anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=             # only if LLM_PROVIDER=anthropic
EMBEDDING_MODEL=text-embedding-3-small
RERANK_MODEL=gpt-4o-mini       # small OpenAI model used as the reranker
RERANK_FAST_PATH_THRESHOLD=0.85  # calibrate on the eval set in M2

# --- Research tools (needed from M3/M5) ----------------------------------------
TAVILY_API_KEY=
CONTEXT7_API_KEY=

# --- Rate limiting (needed in M7) ----------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Observability (M0 setup, optional locally) --------------------------------
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
SENTRY_DSN=
